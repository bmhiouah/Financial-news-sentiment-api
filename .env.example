# Copy this file to .env and fill in your keys.
# .env is loaded automatically by scripts/score_llm.py, GroqSentimentScorer,
# and env_loader.load_project_env().  Never commit .env to git.

# --- API Keys ---

# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Finnhub key is read from OpenBB credentials (obb.user.credentials.finnhub_api_key)
# Set FINNHUB_API_KEY if you use the bare finnhub-python client directly.
FINNHUB_API_KEY=your_key_here

# OpenBB may need its own key depending on the provider used.
# OPENBB_API_KEY=your_key_here

# --- Database ---
# SQLite path (default: data/news.db). Override for PostgreSQL in production:
# FINANCIAL_SENTIMENT_DB=postgresql+psycopg2://user:pass@host:5432/dbname
FINANCIAL_SENTIMENT_DB=data/news.db

# --- Model & Thresholds ---
FINANCIAL_SENTIMENT_FINBERT_MODEL=ProsusAI/finbert
FINANCIAL_SENTIMENT_VLLM_ENDPOINT=http://localhost:8000/v1/chat/completions
FINANCIAL_SENTIMENT_POS_THRESHOLD=0.2
FINANCIAL_SENTIMENT_NEG_THRESHOLD=-0.2
