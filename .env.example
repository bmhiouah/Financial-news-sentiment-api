# Copy this file to .env and fill in your keys.
# .env is loaded automatically at import time by financial_sentiment.config.
# Never commit .env to git.

# --- Database (required) ---
# Start the bundled local PostgreSQL with `python scripts/pg_server.py uri`,
# or point this at your own instance.
# Ignored under Docker: docker-compose.yml sets DATABASE_URL to its own `db`
# service and this value is overridden.
DATABASE_URL=postgresql://postgres:@/financial_sentiment?host=/Users/you/.financial_sentiment/pgdata

# --- Docker (docker-compose.yml only) ---
# Credentials for the postgres container and the ports it publishes.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=financial_sentiment
POSTGRES_PORT=5432
API_PORT=8000

# --- API Keys ---

# Groq LLM scoring (scripts/score_llm.py): https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Finnhub is read from the OpenBB credentials store
# (obb.user.credentials.finnhub_api_key); set this only if you use the bare
# finnhub-python client directly.
# FINNHUB_API_KEY=your_key_here

# --- Model & thresholds ---
FINANCIAL_SENTIMENT_FINBERT_MODEL=ProsusAI/finbert
FINANCIAL_SENTIMENT_POS_THRESHOLD=0.2
FINANCIAL_SENTIMENT_NEG_THRESHOLD=-0.2

# --- OpenBB provider fallback order ---
# An empty entry means "let OpenBB pick its own priority order".
FINANCIAL_SENTIMENT_PRICE_PROVIDERS=fmp,yfinance,tiingo
FINANCIAL_SENTIMENT_NEWS_PROVIDERS=,yfinance

# --- Finnhub pagination ---
FINANCIAL_SENTIMENT_FINNHUB_PAGE_LIMIT=200
FINANCIAL_SENTIMENT_FINNHUB_MAX_PAGES=40
